# Files excluded from the WordPress.org SVN distribution.
# (build/ ships in the release — the compiled editor bundles. vendor/ does not: the
# plugin has no runtime dependencies and autoloads includes/ itself.)

# Dev config
/.git
/.github
/.gitignore
/.distignore
/.wp-env.json
/.wordpress-org
/phpcs.xml.dist
/phpunit.xml.dist
/phpunit-integration.xml.dist
/composer.json
/composer.lock
/package.json
/package-lock.json
/skills-lock.json
/patchwork.json
/webpack.config.js
/.phpunit.result.cache
/.phpcs.cache
/.editorconfig

# Node / JS toolchain
/node_modules
/vendor

# Tests
/tests
/tests-integration

# Docs & source that shouldn't ship
/docs
/.superpowers
/.claude
/.agents
/graphify-out
/dist
README.md
CLAUDE.md
*.zip

# Block source (only the compiled build/ + block.json + render*.php ship)
*.test.js

# OS cruft
.DS_Store
Thumbs.db
